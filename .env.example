# Copy to .env and fill in real values for your environment. Never commit the real .env.
# See docs/ENVIRONMENT.md for what each variable does and when it's required.

QM_SECRET_KEY=
QM_DB_PATH=./qumanity.db
QM_EARTH_ROOT=./0_Earth
MASTER_JSON_PATH=./data/Qumanity_Master.json
QM_HOST=0.0.0.0
PORT=5000
QM_DEBUG=false
QM_DISABLE_SCHEDULER=false
QM_ADMIN_PRIVATE_IDS=
QM_ADMIN_EMAIL=
# SMTP: admin registration-notification emails (email_core.py). Leave SMTP_HOST empty to turn
# notifications off entirely -- registration never depends on these being set. QM_ADMIN_EMAIL
# above is the destination; these describe how to send, not who receives.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDR=
QM_FOUNDER_PIN=
QM_TEST_PIN=
QM_DEV_SHOW_OTP=false
QM_MARQUEE_ENABLED=true
